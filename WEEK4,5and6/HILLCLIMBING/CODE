
N = 4

# Calculate attacking pairs
def calculateCost(state):
    cost = 0

    for i in range(N):
        for j in range(i + 1, N):

            # Same diagonal
            if abs(state[i] - state[j]) == abs(i - j):
                cost += 1

    return cost


# Generate chessboard
def printBoard(state):
    board = [['.' for j in range(N)] for i in range(N)]

    for i in range(N):
        board[state[i]][i] = 'Q'

    for row in board:
        print(" ".join(row))

    print()


# Generate all neighbours by swapping queens
def getNeighbours(state):

    neighbours = []

    for i in range(N):
        for j in range(i + 1, N):

            neighbour = state.copy()

            # Swap two queens
            neighbour[i], neighbour[j] = neighbour[j], neighbour[i]

            cost = calculateCost(neighbour)

            neighbours.append((cost, i, j, neighbour))

    return neighbours


# Hill Climbing Algorithm
def hillClimbing(state):

    step = 1

    while True:

        currentCost = calculateCost(state)

        print("\n========== STEP", step, "==========")
        print("Current State:", state)
        print("Current Cost:", currentCost)

        print("\nCurrent Chessboard:")
        printBoard(state)

        # Goal test
        if currentCost == 0:
            print("GOAL STATE REACHED!")
            return state

        # Generate neighbours
        neighbours = getNeighbours(state)

        print("NEIGHBOUR COST CALCULATIONS:")
        print("--------------------------------")

        for cost, i, j, neighbour in neighbours:

            print("Swap (x" + str(i) + ", x" + str(j) + ")")
            print("Neighbour:", neighbour)
            print("Cost:", cost)
            print()

        # Select minimum cost neighbour
        # Tie-breaking: smallest column pair
        best = min(neighbours, key=lambda x: (x[0], x[1], x[2]))

        bestCost, i, j, bestState = best

        print("SELECTED NEIGHBOUR:")
        print("Swapped Queens: (x" + str(i) + ", x" + str(j) + ")")
        print("Selected State:", bestState)
        print("Selected Cost:", bestCost)

        # Check for local minimum
        if bestCost >= currentCost:
            print("\nNo better neighbour found!")
            print("Hill Climbing Terminated.")
            return state

        # Move to selected neighbour
        state = bestState

        print("\nSelected Chessboard:")
        printBoard(state)

        step += 1


# Main Function
def main():

    # Initial state given in observation
    state = [3, 1, 2, 0]

    print("========== 4 QUEENS HILL CLIMBING ==========")

    print("Initial State:", state)
    print("Initial Cost:", calculateCost(state))

    print("\nInitial Chessboard:")
    printBoard(state)

    # Apply Hill Climbing
    result = hillClimbing(state)

    # Final result
    print("\n========== FINAL SOLUTION ==========")

    print("Final State:", result)
    print("Final Cost:", calculateCost(result))

    print("\nFinal Chessboard:")
    printBoard(result)


main()
