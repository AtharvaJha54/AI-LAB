
import random

N = 4


def calculateObjective(state):
    attacking = 0

    for i in range(N):
        for j in range(i + 1, N):

            if state[i] == state[j]:
                attacking += 1

            if abs(state[i] - state[j]) == abs(i - j):
                attacking += 1

    return attacking


def generateBoard(state):
    board = [['.' for j in range(N)] for i in range(N)]

    for i in range(N):
        board[state[i]][i] = 'Q'

    return board



def printBoard(state):
    board = generateBoard(state)

    for row in board:
        print(" ".join(row))

    print()



def getNeighbour(state):
    bestState = state.copy()
    bestObjective = calculateObjective(state)

    neighbour = state.copy()

    for i in range(N):
        originalRow = state[i]

        for j in range(N):

            if j != originalRow:

                neighbour[i] = j
                cost = calculateObjective(neighbour)

                if cost < bestObjective:
                    bestObjective = cost
                    bestState = neighbour.copy()

            neighbour[i] = originalRow

    return bestState, bestObjective



def hillClimbing(state):

    step = 1

    while True:

        current = calculateObjective(state)

        print("\nStep:", step)
        print("Current State:", state)
        print("Current Cost:", current)

        print("Current Chessboard:")
        printBoard(state)

        if current == 0:
            print("Goal State Reached!")
            return True, state

        oldState = state.copy()

  
        state, neighbourCost = getNeighbour(state)


        if oldState == state:
            print("No better neighbour found!")
            print("Reached Local Minimum.")
            return False, state

        print("Selected Neighbour:", state)
        print("Neighbour Cost:", neighbourCost)
        print("Selected Neighbour Chessboard:")
        printBoard(state)

        print("--------------------------------")

        step += 1



def main():


    state = [3, 1, 2, 0]

    print("========== INITIAL STATE ==========")
    print("Initial State:", state)
    print("Initial Cost:", calculateObjective(state))

    print("\nInitial Chessboard:")
    printBoard(state)

 
    result, state = hillClimbing(state)


    restart = 1

    while not result:

        print("\n========== RANDOM RESTART", restart, "==========")

        state = [random.randint(0, N - 1)
                 for i in range(N)]

        print("New Initial State:", state)
        print("New Initial Cost:", calculateObjective(state))

        print("New Initial Chessboard:")
        printBoard(state)

        result, state = hillClimbing(state)

        restart += 1

   
    print("\n========== SOLUTION FOUND ==========")

    print("Final State:", state)
    print("Final Objective Cost:", calculateObjective(state))

    print("\nFINAL CHESSBOARD:")
    printBoard(state)


main()
